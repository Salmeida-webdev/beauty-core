NODE_ENV=production
PORT=3000

# Banco de dados
DATABASE_URL=postgresql://postgres:CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD_64_CHARS@postgres:5432/beauty_core

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_PRODUCTION_REDIS_PASSWORD_64_CHARS
REDIS_URL=redis://:CHANGE_ME_PRODUCTION_REDIS_PASSWORD_64_CHARS@redis:6379/0

# JWT Admin/Cliente
JWT_SECRET=CHANGE_ME_PRODUCTION_ADMIN_ACCESS_JWT_SECRET_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_ADMIN_REFRESH_JWT_SECRET_64_CHARS
JWT_CLIENT_SECRET=CHANGE_ME_PRODUCTION_CLIENT_ACCESS_JWT_SECRET_64_CHARS
JWT_CLIENT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_CLIENT_REFRESH_JWT_SECRET_64_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
JWT_CLIENT_EXPIRES_IN=7d
JWT_CLIENT_REFRESH_EXPIRES_IN=30d

# CORS: nunca usar * em producao
CORS_ORIGIN=https://app.seudominio.com,https://admin.seudominio.com

# Uploads/Storage
STORAGE_PROVIDER=LOCAL
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOCUMENT_MB=10
MAX_IMAGE_UPLOAD_MB=5
MAX_PDF_UPLOAD_MB=10

# Observabilidade
METRICS_TOKEN=CHANGE_ME_PRODUCTION_METRICS_TOKEN_64_CHARS

# OTP Cliente
OTP_SECRET=CHANGE_ME_PRODUCTION_OTP_SECRET_64_CHARS

# Backup
BACKUP_DIR=/app/backups


# Observabilidade - Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD_64_CHARS

# Backup / Restore
BACKUP_EXECUTION_ENABLED=false
BACKUP_SCRIPT_TIMEOUT_MS=900000
BACKUP_RPO=24h
BACKUP_RTO=4h

# LGPD
LGPD_EXPORT_MAX_ITEMS=5000

# Analytics / Performance
ANALYTICS_TOP_LIMIT=10
ANALYTICS_SCAN_LIMIT=5000

# Meta WhatsApp Cloud API webhook (secrets via secret manager; values intentionally empty)
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
