# =========================================================
# Beauty Core 1.0 â€” Environment Example
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=development
PORT=3000

# Em desenvolvimento pode usar *
# Em produÃ§Ã£o use domÃ­nio real, exemplo:
# CORS_ORIGIN=https://seudominio.com
CORS_ORIGIN=*

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# Local direto:
# DATABASE_URL=CHANGE_ME_DATABASE_URL
#
# Dentro do Docker Compose:
# DATABASE_URL=CHANGE_ME_DATABASE_URL
# DATABASE_URL=CHANGE_ME_DATABASE_URL

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=beauty_core
POSTGRES_PORT=5432

# ---------------------------------------------------------
# Authentication
# ---------------------------------------------------------
# Use valores longos, secretos e diferentes em produÃ§Ã£o.
JWT_SECRET=
JWT_CLIENT_SECRET=

# ---------------------------------------------------------
# Swagger / OpenAPI
# ---------------------------------------------------------
# Em produÃ§Ã£o, deixar false por padrÃ£o.
# Ativar apenas quando necessÃ¡rio.
SWAGGER_ENABLED=true

# ---------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------
# Local:
# REDIS_HOST=localhost
#
# Dentro do Docker Compose:
# REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------
# Scheduler / Cron Jobs
# ---------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Empresa usada em rotinas globais/testes do scheduler, se aplicÃ¡vel.
SCHEDULER_EMPRESA_ID=

# ---------------------------------------------------------
# Uploads
# ---------------------------------------------------------
UPLOADS_DIR=uploads
MAX_IMAGE_UPLOAD_MB=5
MAX_PDF_UPLOAD_MB=10

# ---------------------------------------------------------
# Rate Limit
# ---------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---------------------------------------------------------
# Seed
# ---------------------------------------------------------
SEED_EMPRESA_NOME=Beauty Core Demo
SEED_EMPRESA_EMAIL=demo@beautycore.com
SEED_EMPRESA_TELEFONE=11999999999

SEED_ADMIN_NOME=Admin Demo
SEED_ADMIN_EMAIL=admin@beautycore.com
SEED_ADMIN_PASSWORD=Admin@123456
JWT_EXPIRES_IN=8h
JWT_CLIENT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_CLIENT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
JWT_CLIENT_REFRESH_EXPIRES_IN=30d

# Chat 31 ï¿½ Storage
STORAGE_PROVIDER=LOCAL
UPLOADS_DIR=uploads

UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOCUMENT_MB=10

SIGNED_URL_EXPIRATION=300
SIGNED_URL_SECRET=

# Future S3 Provider
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
AWS_REGION=

# Future Cloudinary Provider
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# BullMQ Enterprise / Chat 32
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=10000
QUEUE_LOCK_TTL=600000
QUEUE_CONCURRENCY_NOTIFICATIONS=5
QUEUE_CONCURRENCY_NOTIFICACOES=5
QUEUE_CONCURRENCY_WHATSAPP=10
QUEUE_CONCURRENCY_CAMPANHAS=3
QUEUE_CONCURRENCY_ANIVERSARIOS=3
QUEUE_CONCURRENCY_RELATORIOS=1
QUEUE_CLEAN_COMPLETED_AGE_MS=604800000
QUEUE_CLEAN_FAILED_AGE_MS=2592000000
QUEUE_CLEAN_LIMIT=1000

# Metrics / Prometheus
METRICS_PUBLIC=false
METRICS_TOKEN=

# Cliente OTP
OTP_SECRET=
OTP_EXPIRES_MINUTES=10


# Observabilidade - Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD_64_CHARS

# Backup / Restore
BACKUP_EXECUTION_ENABLED=false
BACKUP_SCRIPT_TIMEOUT_MS=900000
BACKUP_RPO=24h
BACKUP_RTO=4h

# LGPD
LGPD_EXPORT_MAX_ITEMS=5000

# Analytics / Performance
ANALYTICS_TOP_LIMIT=10
ANALYTICS_SCAN_LIMIT=5000
