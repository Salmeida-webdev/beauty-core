NODE_ENV=production
APP_ENV=production
PORT=3000
API_PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_PROD_POSTGRES_PASSWORD_64_CHARS
POSTGRES_DB=beauty_core
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:CHANGE_ME_PROD_POSTGRES_PASSWORD_64_CHARS@postgres:5432/beauty_core

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_PROD_REDIS_PASSWORD_64_CHARS
REDIS_URL=redis://:CHANGE_ME_PROD_REDIS_PASSWORD_64_CHARS@redis:6379/0

JWT_SECRET=CHANGE_ME_PROD_ADMIN_ACCESS_JWT_SECRET_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_PROD_ADMIN_REFRESH_JWT_SECRET_64_CHARS
JWT_CLIENT_SECRET=CHANGE_ME_PROD_CLIENT_ACCESS_JWT_SECRET_64_CHARS
JWT_CLIENT_REFRESH_SECRET=CHANGE_ME_PROD_CLIENT_REFRESH_JWT_SECRET_64_CHARS

JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
JWT_CLIENT_EXPIRES_IN=7d
JWT_CLIENT_REFRESH_EXPIRES_IN=30d

SWAGGER_ENABLED=false
CORS_ORIGIN=https://app.seudominio.com

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Fortaleza

STORAGE_PROVIDER=LOCAL
UPLOADS_DIR=uploads
SIGNED_URL_SECRET=CHANGE_ME_PROD_SIGNED_URL_SECRET_64_CHARS
SIGNED_URL_EXPIRES_IN_SECONDS=900

THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Metrics / Prometheus
METRICS_PUBLIC=false
METRICS_TOKEN=

# Cliente OTP
OTP_SECRET=
OTP_EXPIRES_MINUTES=10

# Backup / Restore
BACKUP_EXECUTION_ENABLED=false
BACKUP_SCRIPT_TIMEOUT_MS=900000
BACKUP_RPO=24h
BACKUP_RTO=4h

# LGPD
LGPD_EXPORT_MAX_ITEMS=5000

# Analytics / Performance
ANALYTICS_TOP_LIMIT=10
ANALYTICS_SCAN_LIMIT=5000

# Meta WhatsApp Cloud API webhook (secrets via secret manager; values intentionally empty)
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
