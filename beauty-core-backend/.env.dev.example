NODE_ENV=development
PORT=3000
API_PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=beauty_core
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/beauty_core

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@redis:6379/0

JWT_SECRET=dev_admin_access_secret_change_in_real_env
JWT_REFRESH_SECRET=dev_admin_refresh_secret_change_in_real_env
JWT_CLIENT_SECRET=dev_client_access_secret_change_in_real_env
JWT_CLIENT_REFRESH_SECRET=dev_client_refresh_secret_change_in_real_env

JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
JWT_CLIENT_EXPIRES_IN=7d
JWT_CLIENT_REFRESH_EXPIRES_IN=30d

SWAGGER_ENABLED=true
CORS_ORIGIN=*
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Fortaleza

STORAGE_PROVIDER=LOCAL
UPLOADS_DIR=uploads
SIGNED_URL_SECRET=dev_signed_url_secret_change_in_real_env
SIGNED_URL_EXPIRES_IN_SECONDS=900

THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Metrics / Prometheus
METRICS_PUBLIC=false
METRICS_TOKEN=

# Cliente OTP
OTP_SECRET=
OTP_EXPIRES_MINUTES=10

# Backup / Restore
BACKUP_EXECUTION_ENABLED=false
BACKUP_SCRIPT_TIMEOUT_MS=900000
BACKUP_RPO=24h
BACKUP_RTO=4h

# LGPD
LGPD_EXPORT_MAX_ITEMS=5000

# Analytics / Performance
ANALYTICS_TOP_LIMIT=10
ANALYTICS_SCAN_LIMIT=5000
