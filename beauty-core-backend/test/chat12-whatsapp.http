###
### TESTE TOKEN
###

GET {{BASE_URL}}/auth/me
Authorization: Bearer {{TOKEN}}

###
### 1. CRIAR CONFIGURAÇÃO WHATSAPP
###

POST {{BASE_URL}}/configuracao-whatsapp
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "ativo": true,
  "canal": "MODO_DEMONSTRACAO",
  "numeroWhatsApp": "83999999999",
  "mensagemSaudacao": "Olá! Bem-vindo ao Beauty Core.",
  "mensagemAusencia": "Estamos ausentes no momento.",
  "usarModoDemonstracao": true
}

###
### 2. BUSCAR CONFIGURAÇÃO
###

GET {{BASE_URL}}/configuracao-whatsapp
Authorization: Bearer {{TOKEN}}

###
### 3. ATUALIZAR CONFIGURAÇÃO
###

PATCH {{BASE_URL}}/configuracao-whatsapp
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "mensagemSaudacao": "Olá! Obrigado por entrar em contato.",
  "usarModoDemonstracao": true
}

###
### 4. GERAR LINK GRATUITO
###

GET {{BASE_URL}}/configuracao-whatsapp/link?mensagem=Olá,%20gostaria%20de%20agendar%20um%20horário.
Authorization: Bearer {{TOKEN}}

### 5. CRIAR TEMPLATE

POST {{BASE_URL}}/templates-whatsapp
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "nome": "Confirmacao Agendamento",
  "tipo": "CONFIRMACAO_AGENDAMENTO",
  "titulo": "Agendamento Confirmado",
  "mensagem": "Olá NOME_CLIENTE, seu horário foi confirmado para DATA_AGENDAMENTO às HORA_AGENDAMENTO.",
  "ativo": true
}
###
### 6. LISTAR TEMPLATES
###

GET {{BASE_URL}}/templates-whatsapp
Authorization: Bearer {{TOKEN}}

###
### 7. BUSCAR TEMPLATE
###

GET {{BASE_URL}}/templates-whatsapp/{{TEMPLATE_ID}}
Authorization: Bearer {{TOKEN}}

###
### 8. ATUALIZAR TEMPLATE
###

PATCH {{BASE_URL}}/templates-whatsapp/{{TEMPLATE_ID}}
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "titulo": "Confirmação Oficial"
}

###
### 9. INATIVAR TEMPLATE
###

PATCH {{BASE_URL}}/templates-whatsapp/{{TEMPLATE_ID}}/inativar
Authorization: Bearer {{TOKEN}}

###
### 10. CRIAR MENSAGEM
###

POST {{BASE_URL}}/mensagens-whatsapp
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "tipo": "CONFIRMACAO_AGENDAMENTO",
  "destinatario": "83999999999",
  "mensagem": "Mensagem criada para teste."
}

###
### 11. ENVIAR MENSAGEM SIMULADA
###

POST {{BASE_URL}}/mensagens-whatsapp/enviar
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "tipo": "CONFIRMACAO_AGENDAMENTO",
  "destinatario": "83999999999",
  "mensagem": "Mensagem simulada enviada pelo Chat 12."
}

###
### 12. LISTAR MENSAGENS
###

GET {{BASE_URL}}/mensagens-whatsapp
Authorization: Bearer {{TOKEN}}

###
### 13. BUSCAR MENSAGEM
###

GET {{BASE_URL}}/mensagens-whatsapp/{{MENSAGEM_ID}}
Authorization: Bearer {{TOKEN}}

###
### 14. CANCELAR MENSAGEM
###

PATCH {{BASE_URL}}/mensagens-whatsapp/{{MENSAGEM_ID}}/cancelar
Authorization: Bearer {{TOKEN}}

###
### 15. CRIAR CAMPANHA
###

POST {{BASE_URL}}/campanhas-whatsapp
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "nome": "Campanha Junho",
  "descricao": "Campanha demonstrativa",
  "tipo": "CAMPANHA",
  "mensagem": "Promoção especial para nossos clientes.",
  "totalDestinatarios": 50
}

###
### 16. LISTAR CAMPANHAS
###

GET {{BASE_URL}}/campanhas-whatsapp
Authorization: Bearer {{TOKEN}}

###
### 17. BUSCAR CAMPANHA
###

GET {{BASE_URL}}/campanhas-whatsapp/{{CAMPANHA_ID}}
Authorization: Bearer {{TOKEN}}

###
### 18. ATUALIZAR CAMPANHA
###

PATCH {{BASE_URL}}/campanhas-whatsapp/{{CAMPANHA_ID}}
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "descricao": "Campanha demonstrativa atualizada."
}

###
### 19. CANCELAR CAMPANHA
###

PATCH {{BASE_URL}}/campanhas-whatsapp/{{CAMPANHA_ID}}/cancelar
Authorization: Bearer {{TOKEN}}